{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "flaim-fantasy": {
      "type": "remote",
      "url": "https://api.flaim.app/mcp",
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.firecrawl.dev/fc-7016c74043b54b54a47a37f0cd0b5c6e/v2/mcp"
      ],
      "environment": {
        "npm_config_cache": "/Users/sagyakwa/.npm-cache-firecrawl"
      },
      "enabled": true
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "github": {
