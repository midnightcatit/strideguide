{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strideguide-web",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "run.midnightcatit.com/*",
      "zone_name": "midnightcatit.com"
    }
  ]
}
