# Stride Guide local secrets. Copy to .dev.vars and fill in. NEVER commit .dev.vars.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SESSION_SECRET=""
OPENROUTER_API_KEY=""

# TypeSafe AI key for the Jev typed-decision model, used by the coach safety
# classifier. Leave unset to run without it: the classifier is skipped and the
# coach answers normally. Get a key from https://console.typesafe.ai/keys.
# TYPESAFE_API_KEY=""

# Health connectors. Leave unset to run with the connector off (it shows as not
# configured). Google Health falls back to the Google sign-in client above when its
# own values are empty.
GOOGLE_HEALTH_CLIENT_ID=""
GOOGLE_HEALTH_CLIENT_SECRET=""
# Base64 of 32 random bytes, used to encrypt stored tokens. Generate one with:
#   openssl rand -base64 32
CONNECTIONS_KEY=""
# The exact Authorization header Google sends with Health API push notifications,
# set as the subscriber's endpoint secret. Unset keeps the webhook inert.
GOOGLE_HEALTH_WEBHOOK_SECRET=""

# Root admin emails, comma separated and matched case-insensitively. These are
# always admin and can never be demoted or removed through the UI. Production
# reads this from wrangler.jsonc vars, so it is commented out here; uncomment and
# set your own address to override locally while developing the admin surface.
# ADMIN_EMAILS="you@example.com"
