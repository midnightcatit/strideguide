{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strideguide-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "strideguide-db",
      "database_id": "04fdcfe6-d839-4580-886c-fb2ac2fb2e99",
      "migrations_dir": "drizzle"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://run.midnightcatit.com",
    "WEB_ORIGIN": "https://run.midnightcatit.com",
    // Root admins, comma separated and matched case-insensitively. Root admins
    // are always admin and cannot be demoted or removed through the admin UI.
    // This is the production owner's address, the assumed root admin; add more
    // by separating with commas, and change it here if the owner changes.
    "ADMIN_EMAILS": "samuelagyen@gmail.com"
  },
  "triggers": {
    "crons": ["0 7 * * *", "0 8 * * 1"]
  },
  "routes": [
    {
      "pattern": "run.midnightcatit.com/api/*",
      "zone_name": "midnightcatit.com"
    },
    {
      "pattern": "run.midnightcatit.com/auth/*",
      "zone_name": "midnightcatit.com"
    },
    {
      "pattern": "run.midnightcatit.com/connections/*",
      "zone_name": "midnightcatit.com"
    },
    {
      "pattern": "run.midnightcatit.com/webhooks/*",
      "zone_name": "midnightcatit.com"
    }
  ]
}
